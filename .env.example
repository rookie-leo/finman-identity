# MySQL used by docker-compose.yml
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PASSWORD=replace-with-a-local-application-password

# Spring Boot currently uses DB_PASSWORD, with a local fallback configured in application.yaml.
DB_PASSWORD=replace-with-a-local-application-password

# JWT settings. Never commit private keys.
JWT_PRIVATE_KEY_PATH=keys/identity-private.pem
JWT_PUBLIC_KEY_PATH=keys/identity-public.pem
JWT_ISSUER=finman-identity
JWT_AUDIENCE=finman-api
JWT_EXPIRATION_MINUTES=60
